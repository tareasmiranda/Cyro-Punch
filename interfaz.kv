# ══════════ Base ══════════════════════════════════════════════════════════

<Pressable>:
    opacity: 0.8 if self.state == "down" else 1

<BaseTxt>:
    font_name: app.font_name
    color: app.text_color
    font_size: sp(16)
    halign: "left"
    valign: "middle"

<Txt>:
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1]

<TxtAuto>:
    size_hint: None, None
    text_size: None, None
    size: self.texture_size

<Icon@MDIcon>:
    theme_font_size: "Custom"
    font_size: sp(24)
    icon_color: app.text_color

# ══════════ Componentes ═══════════════════════════════════════════════════

<Card>:
    canvas.before:
        Color:
            rgba: self.fill_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]
        Color:
            rgba: self.border_color
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.radius)
            width: 1

<PillButton>:
    anchor_x: "center"
    anchor_y: "center"
    size_hint: None, None
    height: dp(54)
    width: content.width + dp(40)
    canvas.before:
        Color:
            rgba: app.accent_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
    BoxLayout:
        id: content
        size_hint: None, None
        height: dp(54)
        width: self.minimum_width
        spacing: dp(8)
        Icon:
            icon: root.icon
            icon_color: app.accent_fg_color
            font_size: sp(20)
            pos_hint: {"center_y": .5}
        TxtAuto:
            text: root.text
            bold: True
            color: app.accent_fg_color
            font_size: sp(17)
            pos_hint: {"center_y": .5}

<IconButton>:
    anchor_x: "center"
    anchor_y: "center"
    size_hint: None, None
    size: dp(44), dp(44)
    canvas.before:
        Color:
            rgba: app.surface_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    Icon:
        icon: root.icon
        icon_color: app.text_color
        font_size: sp(22)

<NavItem>:
    anchor_x: "center"
    anchor_y: "center"
    canvas.before:
        Color:
            rgba: app.surface_alt_color if self.active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
    BoxLayout:
        orientation: "vertical"
        size_hint: 1, None
        height: self.minimum_height
        spacing: dp(4)
        Icon:
            icon: root.icon
            icon_color: app.accent_color if root.active else app.subtle_color
            font_size: sp(24)
            pos_hint: {"center_x": .5}
        TxtAuto:
            text: root.text
            bold: root.active
            color: app.text_color if root.active else app.subtle_color
            font_size: sp(12.5)
            pos_hint: {"center_x": .5}

<CheckMark>:
    size_hint: None, None
    size: dp(26), dp(26)
    canvas:
        # Casilla vacía: anillo gris (borde) + centro del color de la fila
        Color:
            rgba: app.accent_color if self.active else app.check_border_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: (0, 0, 0, 0) if self.active else app.surface_color
        RoundedRectangle:
            pos: self.x + dp(2.2), self.y + dp(2.2)
            size: self.width - dp(4.4), self.height - dp(4.4)
            radius: [dp(5.8)]
        # Palomita (solo cuando está marcada)
        Color:
            rgba: app.accent_fg_color if self.active else (0, 0, 0, 0)
        Line:
            points:
                [ \
                self.x + self.width * .28, self.y + self.height * .50, \
                self.x + self.width * .44, self.y + self.height * .33, \
                self.x + self.width * .73, self.y + self.height * .68 \
                ]
            width: dp(1.8)
            cap: "round"
            joint: "round"

<SoftProgress>:
    size_hint_y: None
    height: dp(5)
    canvas:
        Color:
            rgba: app.track_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: app.accent_color
        RoundedRectangle:
            pos: self.pos
            size: max(self.width * self.value, self.height if self.value > 0 else 0), self.height
            radius: [self.height / 2]

<ToggleSwitch>:
    size_hint: None, None
    size: dp(50), dp(30)
    canvas:
        Color:
            rgba: mix(app.track_color, app.accent_color, self.progress)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: app.bg_color
        Ellipse:
            pos:
                self.x + dp(4) + (self.width - dp(8) - dp(22)) * self.progress, \
                self.y + dp(4)
            size: dp(22), dp(22)

<ShoppingItem>:
    size_hint_y: None
    height: dp(62)
    padding: dp(18), 0
    spacing: dp(14)
    radius: dp(16)
    fill_color: app.surface_color
    CheckMark:
        active: root.done
        pos_hint: {"center_y": .5}
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        pos_hint: {"center_y": .5}
        spacing: dp(1)
        Txt:
            text: root.title_markup
            markup: True
            font_size: sp(16.5)
            color: app.muted_color if root.done else app.text_color
        Txt:
            text: root.quantity
            font_size: sp(13)
            color: app.muted_color

<SettingRow>:
    size_hint_y: None
    height: dp(62)
    padding: dp(18), 0, dp(16), 0
    spacing: dp(14)
    radius: dp(16)
    fill_color: app.surface_color
    Icon:
        icon: root.icon
        icon_color: app.muted_color
        font_size: sp(22)
        pos_hint: {"center_y": .5}
    Txt:
        text: root.text
        font_size: sp(16.5)
        pos_hint: {"center_y": .5}

<LangOption>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(48)
    padding: dp(16), 0
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: app.surface_alt_color if self.selected else (0, 0, 0, 0)
        Rectangle:
            pos: self.pos
            size: self.size
    Txt:
        text: root.label
        color: app.accent_color if root.selected else app.text_color
        bold: root.selected
        font_size: sp(15.5)
        pos_hint: {"center_y": .5}
    Icon:
        icon: "check"
        icon_color: app.accent_color
        font_size: sp(17)
        opacity: 1 if root.selected else 0
        pos_hint: {"center_y": .5}

<LanguageDropDown>:
    auto_width: False
    width: dp(190)
    canvas.before:
        Color:
            rgba: app.surface_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: app.border_color
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
            width: 1
    LangOption:
        code: "es"
        label: "Español"
        selected: app.lang == "es"
        on_release:
            app.set_language("es")
            root.dismiss()
    LangOption:
        code: "en"
        label: "English"
        selected: app.lang == "en"
        on_release:
            app.set_language("en")
            root.dismiss()

<BottomNav@BoxLayout>:
    size_hint_y: None
    height: dp(84)
    padding: dp(14), dp(11)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: app.nav_bg_color
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: app.border_color
        Line:
            points: self.x, self.top, self.right, self.top
            width: 1
    NavItem:
        key: "inicio"
        icon: "home-outline"
        text: app.tr(app.lang, "nav_home")
        active: app.current_tab == self.key
        on_release: app.go(self.key)
    NavItem:
        key: "listas"
        icon: "format-list-checks"
        text: app.tr(app.lang, "nav_lists")
        active: app.current_tab == self.key
        on_release: app.go(self.key)
    NavItem:
        key: "ajustes"
        icon: "tune-variant"
        text: app.tr(app.lang, "nav_settings")
        active: app.current_tab == self.key
        on_release: app.go(self.key)

# ══════════ Pantallas ═════════════════════════════════════════════════════

<InicioScreen@MDScreen>:
    name: "inicio"
    BoxLayout:
        orientation: "vertical"
        padding: dp(24), dp(64), dp(24), dp(40)
        spacing: dp(14)
        Txt:
            text: app.tr(app.lang, "greeting")
            font_size: sp(38)
            bold: True
            line_height: 1.08
        Txt:
            text: app.tr(app.lang, "greeting_sub")
            font_size: sp(16)
            color: app.muted_color
            line_height: 1.25
        Widget:
        AnchorLayout:
            anchor_x: "right"
            anchor_y: "bottom"
            size_hint_y: None
            height: dp(54)
            PillButton:
                text: app.tr(app.lang, "new_list")
                icon: "plus"
                on_release: app.new_list()

<ListasScreen@MDScreen>:
    name: "listas"
    BoxLayout:
        orientation: "vertical"
        padding: dp(24), dp(64), dp(24), dp(24)
        spacing: dp(26)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(12)
            BoxLayout:
                orientation: "vertical"
                spacing: dp(2)
                Txt:
                    text: app.tr(app.lang, "my_lists")
                    font_size: sp(30)
                    bold: True
                Txt:
                    text: "{} {}".format(app.lists_count, app.tr(app.lang, "active_list_one") if app.lists_count == 1 else app.tr(app.lang, "active_list_many"))
                    font_size: sp(14.5)
                    color: app.muted_color
            PillButton:
                text: app.tr(app.lang, "add")
                icon: "plus"
                pos_hint: {"top": 1}
                on_release: app.new_list()
        TapCard:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: dp(24), dp(24), dp(24), dp(22)
            spacing: dp(20)
            fill_color: app.surface_color
            border_color: app.border_color
            radius: dp(22)
            on_release: app.go("detalle")
            BoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(16)
                AnchorLayout:
                    size_hint: None, None
                    size: dp(48), dp(48)
                    canvas.before:
                        Color:
                            rgba: app.surface_alt_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(14)]
                    Icon:
                        icon: "basket-outline"
                        icon_color: app.accent_color
                        font_size: sp(26)
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    pos_hint: {"center_y": .5}
                    spacing: dp(2)
                    Txt:
                        text: app.tr(app.lang, "weekly_shop")
                        bold: True
                        font_size: sp(17)
                    Txt:
                        text: app.tr(app.lang, "items_completed").format(app.total_items, app.done_items)
                        font_size: sp(14)
                        color: app.muted_color
                Icon:
                    icon: "chevron-right"
                    icon_color: app.muted_color
                    font_size: sp(20)
                    pos_hint: {"center_y": .5}
            BoxLayout:
                size_hint_y: None
                height: dp(18)
                spacing: dp(9)
                Widget:
                    size_hint: None, None
                    size: dp(8), dp(8)
                    pos_hint: {"center_y": .5}
                    canvas:
                        Color:
                            rgba: app.accent_color
                        Ellipse:
                            pos: self.pos
                            size: self.size
                Txt:
                    text: app.tr(app.lang, "updated_today")
                    font_size: sp(12.5)
                    color: app.muted_color
                    pos_hint: {"center_y": .5}
        Widget:

<DetalleScreen@MDScreen>:
    name: "detalle"
    BoxLayout:
        orientation: "vertical"
        padding: dp(24), dp(56), dp(24), dp(16)
        spacing: dp(22)
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            spacing: dp(16)
            IconButton:
                icon: "arrow-left"
                pos_hint: {"center_y": .5}
                on_release: app.go("listas")
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                pos_hint: {"center_y": .5}
                spacing: dp(1)
                Txt:
                    text: app.tr(app.lang, "weekly_shop")
                    font_size: sp(28)
                    bold: True
                Txt:
                    text: app.list_date
                    font_size: sp(14)
                    color: app.muted_color
            Icon:
                icon: "dots-horizontal"
                icon_color: app.muted_color
                font_size: sp(24)
                pos_hint: {"center_y": .5}
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(9)
            BoxLayout:
                size_hint_y: None
                height: dp(16)
                Txt:
                    text: app.tr(app.lang, "completed_of").format(app.done_items, app.total_items)
                    font_size: sp(13)
                    color: app.muted_color
                TxtAuto:
                    text: "{}%".format(app.percent)
                    font_size: sp(13)
                    bold: True
                    color: app.accent_color
            SoftProgress:
                value: app.progress
        ScrollView:
            bar_width: 0
            do_scroll_x: False
            BoxLayout:
                id: item_list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

<AjustesScreen@MDScreen>:
    name: "ajustes"
    BoxLayout:
        orientation: "vertical"
        padding: dp(24), dp(64), dp(24), dp(24)
        spacing: dp(34)
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(56)
            spacing: dp(2)
            Txt:
                text: app.tr(app.lang, "settings")
                font_size: sp(30)
                bold: True
            Txt:
                text: app.tr(app.lang, "settings_sub")
                font_size: sp(14.5)
                color: app.muted_color
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(8)
            SettingRow:
                icon: "moon-waning-crescent"
                text: app.tr(app.lang, "dark_mode")
                ToggleSwitch:
                    active: app.theme_dark
                    pos_hint: {"center_y": .5}
                    on_active: app.set_dark_mode(self.active)
            SettingRow:
                icon: "bell-outline"
                text: app.tr(app.lang, "notifications")
                Icon:
                    icon: "chevron-right"
                    icon_color: app.muted_color
                    font_size: sp(20)
                    pos_hint: {"center_y": .5}
            SettingRow:
                icon: "web"
                text: app.tr(app.lang, "language")
                on_release: app.open_language_menu(self)
                TxtAuto:
                    text: app.tr(app.lang, "language_name")
                    color: app.muted_color
                    font_size: sp(15)
                    pos_hint: {"center_y": .5}
                Icon:
                    icon: "chevron-right"
                    icon_color: app.muted_color
                    font_size: sp(20)
                    pos_hint: {"center_y": .5}
        Widget:

# ══════════ Raíz ══════════════════════════════════════════════════════════

MDBoxLayout:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: app.bg_color
        Rectangle:
            pos: self.pos
            size: self.size
    MDScreenManager:
        id: sm
        InicioScreen:
        ListasScreen:
        DetalleScreen:
        AjustesScreen:
    BottomNav:
