<DetalleScreen@MDScreen>:
    name: "detalle"
    BoxLayout:
        orientation: "vertical"
        padding: dp(24), dp(56), dp(24), dp(24)
        # ── Header ─────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            spacing: dp(14)
            IconButton:
                icon: "arrow-left"
                pos_hint: {"center_y": .5}
                on_release: app.go("listas")
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                pos_hint: {"center_y": .5}
                spacing: dp(1)
                Txt:
                    text: app.detail_name
                    font_size: sp(26)
                    bold: True
                    shorten: True
                    shorten_from: "right"
                Txt:
                    text: app.detail_meta
                    font_size: sp(14)
                    color: app.muted_color
                    shorten: True
                    shorten_from: "right"
            IconButton:
                icon: "pencil-outline"
                pos_hint: {"center_y": .5}
                on_release: app.open_form_edit()
        # ── Add-item row (moved up) ────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(68) if app.detail_kind == "checklist" else 0
            opacity: 1 if app.detail_kind == "checklist" else 0
            disabled: app.detail_kind != "checklist"
            padding: 0, dp(14), 0, 0
            spacing: dp(8)
            QuickInput:
                size_hint_x: .62
                hint: app.tr(app.lang, "add_product_hint")
                text: app.new_item_name
                on_text: app.new_item_name = self.text
                on_submit: app.add_item()
            QuickInput:
                size_hint_x: .38
                numeric: True
                hint: app.tr(app.lang, "price_hint")
                text: app.new_item_price
                on_text: app.new_item_price = self.text
                on_submit: app.add_item()
            AddButton:
                icon: "plus"
                on_release: app.add_item()
        # ── Progress ───────────────────────────────────────────────────
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height if app.detail_kind == "checklist" else 0
            opacity: 1 if app.detail_kind == "checklist" else 0
            padding: 0, dp(18), 0, 0
            spacing: dp(9)
            BoxLayout:
                size_hint_y: None
                height: dp(16)
                Txt:
                    text: app.tr(app.lang, "completed_of").format(app.done_items, app.total_items)
                    font_size: sp(13)
                    color: app.muted_color
                TxtAuto:
                    text: "{}%".format(app.percent)
                    font_size: sp(13)
                    bold: True
                    color: app.accent_color
            SoftProgress:
                value: app.progress
        # ── Items body (fills remaining space) ─────────────────────────
        BoxLayout:
            id: body
            orientation: "vertical"
            padding: 0, dp(18), 0, 0
        # ── Total (moved down, directly above BottomNav) ──────────────
        BoxLayout:
            size_hint_y: None
            height: dp(52) if app.detail_kind == "checklist" else 0
            opacity: 1 if app.detail_kind == "checklist" else 0
            padding: dp(4), dp(18), dp(4), 0
            Txt:
                text: app.tr(app.lang, "total_label")
                font_size: sp(15)
                bold: True
                color: app.muted_color
                pos_hint: {"center_y": .5}
            TxtAuto:
                text: app.total_text
                font_size: sp(22)
                bold: True
                color: app.accent_color
                pos_hint: {"center_y": .5}